# Exemplo de configuração local do Orquestra (opcional)
# Se configurado, habilita a integração inteligente com a memória viva e índice de conhecimento:
# ORQ_CEREBRO_PATH=/path/to/private/cerebro

# Nome do usuário exibido em personas e skills (padrão: usuário do sistema operacional)
# ORQ_USER_NAME=kamus

# Nome da edição customizada exibida no título e skills (padrão: vazio)
# ORQ_EDITION_NAME=Kamus Edition
